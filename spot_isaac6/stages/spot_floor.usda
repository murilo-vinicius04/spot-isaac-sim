#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "physicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        custom token physxScene:solverType = "TGS"
        custom uint physxScene:timeStepsPerSecond = 200
    }

    def "looks"
    {
        def Material "floor_phys" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1
            float physics:restitution = 0
            float physics:staticFriction = 1
        }

        def Material "floor"
        {
            token outputs:surface.connect = </World/looks/floor/s.outputs:surface>

            def Shader "s"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.42, 0.43)
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "stripe"
        {
            token outputs:surface.connect = </World/looks/stripe/s.outputs:surface>

            def Shader "s"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.22, 0.22, 0.24)
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "spot_phys" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1
            float physics:restitution = 0
            float physics:staticFriction = 1
            custom token physxMaterial:frictionCombineMode = "max"
            custom token physxMaterial:restitutionCombineMode = "min"
        }
    }

    def Cube "ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/looks/floor>
        rel material:binding:physics = </World/looks/floor_phys> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double size = 1
        float3 xformOp:scale = (40, 40, 0.1)
        double3 xformOp:translate = (0, 0, -0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "stripes"
    {
        def Cube "x00" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/looks/stripe>
            double size = 1
            float3 xformOp:scale = (0.03, 20, 0.001)
            double3 xformOp:translate = (-10, 0, 0.0005)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

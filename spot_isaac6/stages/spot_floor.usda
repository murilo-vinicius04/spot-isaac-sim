    def DomeLight "dome"
    {
        color3f inputs:color = (0.55, 0.56, 0.58)
        float inputs:intensity = 1200
    }

    def DistantLight "key"
    {
        float inputs:angle = 1.5
        float inputs:intensity = 1800
        float3 xformOp:rotateXYZ = (-52, 0, 34)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Xform "spot" (
        prepend references = @../assets/spot_legcol/spot_with_arm/spot_with_arm.usda@
    )
    {
        float xformOp:rotateZ = 0
        double3 xformOp:translate = (0, 0, 0.65)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        over "Geometry"
        {
            over "body" (
                prepend apiSchemas = ["PhysxArticulationAPI", "PhysicsFilteredPairsAPI"]
            )
            {
                rel physics:filteredPairs = [
                    </World/spot/Geometry/body/fl_hip>,
                    </World/spot/Geometry/body/fl_hip/fl_uleg>,
                    </World/spot/Geometry/body/fl_hip/fl_uleg/fl_lleg>,
                    </World/spot/Geometry/body/fl_hip/fl_uleg/fl_lleg/fl_foot>,
                    </World/spot/Geometry/body/fr_hip>,
                    </World/spot/Geometry/body/fr_hip/fr_uleg>,
                    </World/spot/Geometry/body/fr_hip/fr_uleg/fr_lleg>,
                    </World/spot/Geometry/body/fr_hip/fr_uleg/fr_lleg/fr_foot>,
                    </World/spot/Geometry/body/hl_hip>,
                    </World/spot/Geometry/body/hl_hip/hl_uleg>,
                    </World/spot/Geometry/body/hl_hip/hl_uleg/hl_lleg>,
                    </World/spot/Geometry/body/hl_hip/hl_uleg/hl_lleg/hl_foot>,
                    </World/spot/Geometry/body/hr_hip>,
                    </World/spot/Geometry/body/hr_hip/hr_uleg>,
                    </World/spot/Geometry/body/hr_hip/hr_uleg/hr_lleg>,
                    </World/spot/Geometry/body/hr_hip/hr_uleg/hr_lleg/hr_foot>,
                    </World/spot/Geometry/body/arm_link_sh0>,
                    </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1>,
                    </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0>,
                    </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1>,
                    </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0>,
                    </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0/arm_link_wr1>,
                    </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0/arm_link_wr1/arm_link_fngr>,
                    </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0/arm_link_wr1/arm_link_jaw>,
                ]
                custom bool physxArticulation:enabledSelfCollisions = 1
                custom int physxArticulation:solverPositionIterationCount = 8
                custom int physxArticulation:solverVelocityIterationCount = 1

                over "fl_hip" (
                    prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
                )
                {
                    rel physics:filteredPairs = [
                        </World/spot/Geometry/body>,
                        </World/spot/Geometry/body/fl_hip/fl_uleg>,
                        </World/spot/Geometry/body/fl_hip/fl_uleg/fl_lleg>,
                        </World/spot/Geometry/body/fl_hip/fl_uleg/fl_lleg/fl_foot>,
                        </World/spot/Geometry/body/arm_link_sh0>,
                        </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1>,
                        </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0>,
                        </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1>,
                        </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0>,
                        </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0/arm_link_wr1>,
                        </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0/arm_link_wr1/arm_link_fngr>,
                        </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0/arm_link_wr1/arm_link_jaw>,
                    ]

                    over "fl_uleg" (
                        prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
                    )
                    {
                        rel physics:filteredPairs = [
                            </World/spot/Geometry/body>,
                            </World/spot/Geometry/body/fl_hip>,
                            </World/spot/Geometry/body/fl_hip/fl_uleg/fl_lleg>,
                            </World/spot/Geometry/body/fl_hip/fl_uleg/fl_lleg/fl_foot>,
                            </World/spot/Geometry/body/arm_link_sh0>,
                            </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1>,
                            </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0>,
                            </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1>,
                            </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0>,
                            </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0/arm_link_wr1>,
                            </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0/arm_link_wr1/arm_link_fngr>,
                            </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0/arm_link_wr1/arm_link_jaw>,
                        ]

                        over "fl_lleg" (
                            prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
                        )
                        {
                            rel physics:filteredPairs = [
                                </World/spot/Geometry/body>,
                                </World/spot/Geometry/body/fl_hip>,
                                </World/spot/Geometry/body/fl_hip/fl_uleg>,
                                </World/spot/Geometry/body/fl_hip/fl_uleg/fl_lleg/fl_foot>,
                                </World/spot/Geometry/body/arm_link_sh0>,
                                </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1>,
                                </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0>,
                                </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1>,
                                </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0>,
                                </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0/arm_link_wr1>,
                                </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0/arm_link_wr1/arm_link_fngr>,
                                </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0/arm_link_wr1/arm_link_jaw>,
                            ]

                            over "fl_foot" (
                                prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
                            )
                            {
                                rel physics:filteredPairs = [
                                    </World/spot/Geometry/body>,
                                    </World/spot/Geometry/body/fl_hip>,
                                    </World/spot/Geometry/body/fl_hip/fl_uleg>,
                                    </World/spot/Geometry/body/fl_hip/fl_uleg/fl_lleg>,
                                    </World/spot/Geometry/body/arm_link_sh0>,
                                    </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1>,
                                    </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0>,
                                    </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1>,
                                    </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0>,
                                    </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0/arm_link_wr1>,
                                    </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0/arm_link_wr1/arm_link_fngr>,
                                    </World/spot/Geometry/body/arm_link_sh0/arm_link_sh1/arm_link_el0/arm_link_el1/arm_link_wr0/arm_link_wr1/arm_link_jaw>,
                                ]

                                over "sphere" (
                                    prepend apiSchemas = ["MaterialBindingAPI"]
                                )
                                {
                                    custom rel material:binding:physics = </World/looks/spot_phys>
                                }
                            }

                            over "lower_leg_collision" (
                                prepend apiSchemas = ["MaterialBindingAPI"]
                            )
                            {
                                custom rel material:binding:physics = </World/looks/spot_phys>
                            }
                        }

                        over "upper_leg_collision" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            custom rel material:binding:physics = </World/looks/spot_phys>
                        }
                    }
                }

                over "fr_hip" (
                    prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
                )
                {
                    rel physics:filteredPairs = [
                        </World/spot/Geometry/body>,
                        </World/spot/Geometry/body/fr_hip/fr_uleg>,
                        </World/spot/Geometry/body/fr_hip/fr_uleg/fr_lleg>,
                        </World/spot/Geometry/body/fr_hip/fr_uleg/fr_lleg/fr_foot>,
                        </World/spot/Geometry/body/arm_link_sh0>,

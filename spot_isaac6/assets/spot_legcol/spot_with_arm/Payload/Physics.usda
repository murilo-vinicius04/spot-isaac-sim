    over "Geometry"
    {
        over "body" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI", "NewtonMassAPI"]
        )
        {
            double[] newton:inertia = [0.081543792, 0.549231154, 0.569454373, 0, 0, 0]
            bool newton:selfCollisionEnabled = 1
            # Trunk vs every leg link: these OVERLAP BY CONSTRUCTION on Spot and produce
            # ~426 kN of phantom contact if left enabled (ASSETS.md, Defect 3). Leg-vs-leg
            # is deliberately absent -- that is the contact we want the policy to feel.
            rel physics:filteredPairs = [
        </spot_with_arm/Geometry/body/fl_hip>,
        </spot_with_arm/Geometry/body/fl_hip/fl_uleg>,
        </spot_with_arm/Geometry/body/fl_hip/fl_uleg/fl_lleg>,
        </spot_with_arm/Geometry/body/fl_hip/fl_uleg/fl_lleg/fl_foot>,
        </spot_with_arm/Geometry/body/fr_hip>,
        </spot_with_arm/Geometry/body/fr_hip/fr_uleg>,

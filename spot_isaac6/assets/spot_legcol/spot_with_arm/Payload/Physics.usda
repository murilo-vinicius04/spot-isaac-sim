                    float3 physics:diagonalInertia = (0.002986656, 0.02602537, 0.026939424)
                    float physics:mass = 2.2562037
                    quatf physics:principalAxes = (-0.69866294, -0.017117504, 0.7136893, 0.047165737)

                    over "upper_leg_collision" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                    }

                    over "fl_lleg" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                    )
                    {
                        double[] newton:inertia = [0.00701356, 0.00709946, 0.00014529, 0, 0.000066, 0]

                point3f physics:centerOfMass = (-0.01586739, 0.00855842, 0.00000903)
                float3 physics:diagonalInertia = (0.0011499592, 0.0016612653, 0.0017290356)
                float physics:mass = 1.1368834
                quatf physics:principalAxes = (0.9816311, 0.0044215363, 0.0010484322, 0.19073467)

                over "fl_uleg" (

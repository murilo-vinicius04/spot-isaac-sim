        </spot_with_arm/Geometry/body/hl_hip/hl_uleg/hl_lleg>,
        </spot_with_arm/Geometry/body/hl_hip/hl_uleg/hl_lleg/hl_foot>,
        </spot_with_arm/Geometry/body/hr_hip>,
        </spot_with_arm/Geometry/body/hr_hip/hr_uleg>,
        </spot_with_arm/Geometry/body/hr_hip/hr_uleg/hr_lleg>,
        </spot_with_arm/Geometry/body/hr_hip/hr_uleg/hr_lleg/hr_foot>
            ]
            point3f physics:centerOfMass = (0, 0, -0.00496172)
            float3 physics:diagonalInertia = (0.08154379, 0.5492312, 0.5694544)
            float physics:mass = 16.707651
            quatf physics:principalAxes = (1, 0, 0, 0)

            over "body_collision" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
            }

